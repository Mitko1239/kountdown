<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="mode" type="String"><default>duration</default></entry>
    <entry name="targetDateTime" type="String"><default></default></entry>
    <entry name="durationHours" type="Int"><default>0</default></entry>
    <entry name="durationMinutes" type="Int"><default>0</default></entry>
    <entry name="durationSeconds" type="Int"><default>0</default></entry>
    <entry name="timerName" type="String"><default></default></entry>
    <entry name="title" type="String"><default>Kountdown</default></entry>
    <entry name="showSeconds" type="Bool"><default>true</default></entry>
    <entry name="notificationsEnabled" type="Bool"><default>true</default></entry>
    <entry name="soundEnabled" type="Bool"><default>true</default></entry>
    <entry name="notificationSound" type="String"><default>/usr/share/sounds/ocean/stereo/alarm-clock-elapsed.oga</default></entry>
    <entry name="hasInitializedStartupState" type="Bool"><default>false</default></entry>
    <entry name="activeTimerRunning" type="Bool"><default>false</default></entry>
    <entry name="activeTimerTargetTimestamp" type="String"><default>0</default></entry>
  </group>
</kcfg>